# allowPublicKeyRetrieval is required for local MySQL 8 users that authenticate
# with caching_sha2_password.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/expense_tracker?allowPublicKeyRetrieval=true"

# Used by NextAuth to sign/encrypt tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-random-secret"

# Required by NextAuth when the app is served from a custom host in production
# (self-hosted or preview deployments). Hosts are trusted automatically on Vercel.
AUTH_TRUST_HOST="true"

# The app's public address, used for the links in emails (reset password,
# confirm email, undo). Set it to the deployed URL in production.
APP_URL="http://localhost:3000"

# Sends the emails (signup code, password reset, notifications). Create a key at
# https://resend.com/api-keys. Without it in development, emails aren't sent and
# their links and codes are printed in the terminal instead. Required in production.
RESEND_API_KEY="re_your_api_key"

# The sender of every email. onboarding@resend.dev only delivers to the address
# that owns the Resend account, so production needs a domain verified in Resend.
RESEND_FROM="Expense Tracker <onboarding@resend.dev>"

# Required for authenticated profile photo uploads
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
